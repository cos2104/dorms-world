{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "icn1"
  ],
  "rewrites": [
    {
      "source": "/world/g/:path*",
      "destination": "/world/index.html"
    },
    {
      "source": "/world/pad",
      "destination": "/world/index.html"
    },
    {
      "source": "/world/make",
      "destination": "/world/index.html"
    },
    {
      "source": "/world/review/:n",
      "destination": "/world/index.html"
    },
    {
      "source": "/",
      "destination": "/world/index.html"
    }
  ],
  "headers": [
    {
      "source": "/world/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://dorms.school https://dorms-world-rooms.dorms-world-room-server.workers.dev wss://dorms-world-rooms.dorms-world-room-server.workers.dev; img-src 'self' data: blob: https://raw.githubusercontent.com https://dorms.school; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'self' https://dorms.school https://www.dorms.school; base-uri 'none'; object-src 'none'; form-action 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
